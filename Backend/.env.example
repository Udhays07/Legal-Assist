# Example environment variables for Legal Assistant backend
# Copy this file to .env and fill in real values before running the app

# PostgreSQL connection URL (SQLAlchemy format)
DATABASE_URL=postgresql://postgres:password@localhost:5432/legal_assistant

# JWT / security
SECRET_KEY=please_change_this_to_a_secure_random_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: enable debug features
# DEBUG=true

GROQ_API_KEY=groq_api_key