{
  "info": {
    "name": "Legal Assistant Backend API",
    "description": "Complete API collection for testing Legal Assistant backend with RAG capabilities",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "123e4567-e89b-12d3-a456-426614174000",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "conversation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "message_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "Application Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "RAG System Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rag/health",
              "host": ["{{base_url}}"],
              "path": ["rag", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('category_id', response.id);",
                  "    console.log('Category ID saved:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Indian Penal Code\",\n  \"description\": \"Sections and provisions from IPC\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/categories/",
              "host": ["{{base_url}}"],
              "path": ["categories", ""]
            }
          }
        },
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories/?include_inactive=false",
              "host": ["{{base_url}}"],
              "path": ["categories", ""],
              "query": [
                {
                  "key": "include_inactive",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "Get Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories/{{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["categories", "{{category_id}}"]
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Category Name\",\n  \"description\": \"Updated description\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/categories/{{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["categories", "{{category_id}}"]
            }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories/{{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["categories", "{{category_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Create Document (Text)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('document_id', response.id);",
                  "    console.log('Document ID saved:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "category_id",
                  "value": "{{category_id}}",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Section 302 IPC - Punishment for Murder",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "Section 302 of the Indian Penal Code deals with punishment for murder. Whoever commits murder shall be punished with death, or imprisonment for life, and shall also be liable to fine. This is one of the most serious offenses under the IPC.",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "[\"ipc\", \"criminal law\", \"murder\"]",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "published",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/documents/",
              "host": ["{{base_url}}"],
              "path": ["documents", ""]
            }
          }
        },
        {
          "name": "Create Document (File Upload)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "category_id",
                  "value": "{{category_id}}",
                  "type": "text"
                },
                {
                  "key": "title",
                  "value": "Insurance Policy Document",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "tags",
                  "value": "[\"insurance\", \"policy\"]",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "published",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/documents/",
              "host": ["{{base_url}}"],
              "path": ["documents", ""]
            }
          }
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/",
              "host": ["{{base_url}}"],
              "path": ["documents", ""]
            }
          }
        },
        {
          "name": "List Documents by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/?category_id={{category_id}}&status=published",
              "host": ["{{base_url}}"],
              "path": ["documents", ""],
              "query": [
                {
                  "key": "category_id",
                  "value": "{{category_id}}"
                },
                {
                  "key": "status",
                  "value": "published"
                }
              ]
            }
          }
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}"]
            }
          }
        },
        {
          "name": "Update Document",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Document Title\",\n  \"content\": \"Updated content with new information...\",\n  \"tags\": [\"updated\", \"revised\"],\n  \"status\": \"published\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}"]
            }
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "RAG System",
      "item": [
        {
          "name": "RAG Query (New Conversation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('conversation_id', response.conversation_id);",
                  "    pm.collectionVariables.set('message_id', response.message_id);",
                  "    console.log('Conversation ID saved:', response.conversation_id);",
                  "    console.log('Message ID saved:', response.message_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What is the punishment for murder under IPC?\",\n  \"user_id\": \"{{user_id}}\",\n  \"conversation_id\": null,\n  \"top_k\": 5,\n  \"min_similarity\": 0.3,\n  \"category_id\": null,\n  \"include_sources\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/rag/query",
              "host": ["{{base_url}}"],
              "path": ["rag", "query"]
            }
          }
        },
        {
          "name": "RAG Query (Follow-up)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What are the exceptions to this law?\",\n  \"user_id\": \"{{user_id}}\",\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"top_k\": 5,\n  \"min_similarity\": 0.3,\n  \"include_sources\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/rag/query",
              "host": ["{{base_url}}"],
              "path": ["rag", "query"]
            }
          }
        },
        {
          "name": "RAG Query (Category Filter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Tell me about insurance claims\",\n  \"user_id\": \"{{user_id}}\",\n  \"conversation_id\": null,\n  \"top_k\": 5,\n  \"min_similarity\": 0.3,\n  \"category_id\": \"{{category_id}}\",\n  \"include_sources\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/rag/query",
              "host": ["{{base_url}}"],
              "path": ["rag", "query"]
            }
          }
        },
        {
          "name": "Semantic Search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"insurance claims settlement\",\n  \"top_k\": 10,\n  \"min_similarity\": 0.5,\n  \"category_id\": null,\n  \"status\": \"published\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/rag/search",
              "host": ["{{base_url}}"],
              "path": ["rag", "search"]
            }
          }
        },
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rag/conversations?user_id={{user_id}}&limit=20",
              "host": ["{{base_url}}"],
              "path": ["rag", "conversations"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get Conversation History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rag/conversations/{{conversation_id}}?user_id={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["rag", "conversations", "{{conversation_id}}"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Submit Feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"feedback\": \"Very helpful and accurate answer!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/rag/feedback?message_id={{message_id}}",
              "host": ["{{base_url}}"],
              "path": ["rag", "feedback"],
              "query": [
                {
                  "key": "message_id",
                  "value": "{{message_id}}"
                }
              ]
            }
          }
        }
      ]
    },
